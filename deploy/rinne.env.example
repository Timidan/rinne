# Rinne server environment — copy to /etc/rinne.env on the droplet and `chmod 600`.
# Loaded by the systemd unit (EnvironmentFile). Never commit the filled-in copy.

# --- Hosted mode (required in production) -----------------------------------
# With RINNE_HOSTED=1 the server refuses to start unless both provider keys are
# present, so it never silently degrades to error-only ("review") evidence.
RINNE_HOSTED=1

# Live evidence providers. Surf now requires a PAID key (it returns HTTP 402
# without one); Nansen is required for address-risk labels. Server-side only —
# these are never echoed in responses or logs.
SURF_API_KEY=replace-with-your-surf-key
NANSEN_API_KEY=replace-with-your-nansen-key

# --- Server -----------------------------------------------------------------
# Port the Node process listens on. nginx proxies to this on loopback.
PORT=4517
# Bind address. Keep 127.0.0.1 (loopback) — nginx faces the internet, not Node.
# Set 0.0.0.0 ONLY if you intend to expose the process directly with no proxy.
RINNE_HOST=127.0.0.1

# Same-origin (your domain) and localhost are always allowed for the dashboard.
# Add extra cross-origin API callers here, comma-separated, if you ever need to:
# RINNE_ALLOWED_ORIGINS=https://console.partner.example

# Canonical public origin. Set this in production so the served /skill.md always
# pins agents to the real host, regardless of the incoming Host header (prevents
# a forged-Host request from poisoning the install URLs). Omit for local dev.
RINNE_PUBLIC_ORIGIN=https://rinne.timidan.xyz
