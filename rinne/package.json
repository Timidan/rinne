{
  "name": "rinne",
  "version": "0.1.0",
  "private": true,
  "description": "Adversarial replay harness for Mantle AI agents: external Agents, live Surf market data, deterministic verdicts.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "rinne": "dist/src/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "doctor": "pnpm build && node dist/src/cli/index.js doctor",
    "serve": "pnpm build && node dist/src/cli/index.js serve",
    "test": "pnpm build && node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0"
  }
}
